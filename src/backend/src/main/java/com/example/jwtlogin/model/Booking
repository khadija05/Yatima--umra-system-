package com.example.jwtlogin.model;
import jakarta.persistence.*; import java.time.LocalDateTime;
@Entity @Table(name="bookings")
public class Booking {
  @Id @GeneratedValue(strategy=GenerationType.IDENTITY) private Long id;
  private String username; private Long packageId; private String jinaPackage; private String aina; private Double bei; private Integer miezi;
  private LocalDateTime tareheKuanza; private LocalDateTime tareheMwisho; private Boolean imelipa=false; private String njiaMalipo; private String nambaMuamala;
  private String status="ACTIVE"; private Integer sikuZilizobaki; private LocalDateTime createdAt=LocalDateTime.now();
  public Booking(){}
  public Long getId(){return id;} public void setId(Long v){id=v;}
  public String getUsername(){return username;} public void setUsername(String v){username=v;}
  public Long getPackageId(){return packageId;} public void setPackageId(Long v){packageId=v;}
  public String getJinaPackage(){return jinaPackage;} public void setJinaPackage(String v){jinaPackage=v;}
  public String getAina(){return aina;} public void setAina(String v){aina=v;}
  public Double getBei(){return bei;} public void setBei(Double v){bei=v;}
  public Integer getMiezi(){return miezi;} public void setMiezi(Integer v){miezi=v;}
  public LocalDateTime getTareheKuanza(){return tareheKuanza;} public void setTareheKuanza(LocalDateTime v){tareheKuanza=v;}
  public LocalDateTime getTareheMwisho(){return tareheMwisho;} public void setTareheMwisho(LocalDateTime v){tareheMwisho=v;}
  public Boolean getImelipa(){return imelipa;} public void setImelipa(Boolean v){imelipa=v;}
  public String getNjiaMalipo(){return njiaMalipo;} public void setNjiaMalipo(String v){njiaMalipo=v;}
  public String getNambaMuamala(){return nambaMuamala;} public void setNambaMuamala(String v){nambaMuamala=v;}
  public String getStatus(){return status;} public void setStatus(String v){status=v;}
  public Integer getSikuZilizobaki(){return sikuZilizobaki;} public void setSikuZilizobaki(Integer v){sikuZilizobaki=v;}
  public LocalDateTime getCreatedAt(){return createdAt;} public void setCreatedAt(LocalDateTime v){createdAt=v;}
}
