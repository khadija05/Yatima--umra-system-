*{box-sizing:border-box;margin:0;padding:0}
:root{--green:#059669;--dark:#065f46;--gold:#f59e0b;--bg:#f0fdf4;--card:#fff}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:#111827;line-height:1.5}
a{text-decoration:none;color:inherit}
.topbar{background:linear-gradient(135deg,#064e3b,#059669,#10b981);color:#fff;padding:12px 16px;display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:100;box-shadow:0 4px 20px rgba(0,0,0,.2)}
.hamburger{display:none;font-size:24px;background:rgba(255,255,255,.2);border:none;color:#fff;width:42px;height:42px;border-radius:10px;cursor:pointer}
.logo{font-weight:900;font-size:20px;letter-spacing:.3px;flex:1}.logo span{color:#fde68a}
.user-box{font-size:13px;display:flex;gap:8px;align-items:center;background:rgba(255,255,255,.15);padding:6px 10px;border-radius:20px}
.user-box button{background:#ef4444;color:#fff;border:none;padding:6px 12px;border-radius:20px;cursor:pointer;font-weight:700}
.layout{display:flex;min-height:calc(100vh - 60px)}
.sidebar{width:250px;background:#fff;padding:16px;border-right:1px solid #e5e7eb;display:flex;flex-direction:column;gap:6px;position:sticky;top:60px;height:calc(100vh - 60px);transition:.3s;z-index:90}
.sidebar a{padding:13px 14px;border-radius:12px;color:#374151;font-size:14.5px;font-weight:600;display:flex;gap:10px;align-items:center}
.sidebar a:hover,.sidebar a.active{background:var(--dark);color:#fff;transform:translateX(4px)}
.sidebar .close-btn{display:none}
.main{flex:1;padding:22px;max-width:1100px;margin:0 auto;width:100%}.overlay{display:none}
.card{background:var(--card);padding:22px;border-radius:18px;box-shadow:0 4px 20px rgba(0,0,0,.06);margin-bottom:16px;border:1px solid #f0f0f0}
.hero{background:linear-gradient(135deg,#064e3b,#059669);color:#fff;padding:30px;border-radius:20px;margin-bottom:18px}
.hero h1{font-size:28px;line-height:1.2}.hero p{opacity:.9;margin:12px 0 18px}.hero-btns{display:flex;gap:10px;flex-wrap:wrap}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.stat{font-size:34px;font-weight:900;color:var(--dark)} .muted{color:#6b7280;font-size:13.5px}
input,select,textarea{width:100%;padding:14px;margin:6px 0 12px;border:1.5px solid #e5e7eb;border-radius:12px;font-size:15px;background:#fafafa;outline:none}
input:focus,select:focus{border-color:var(--green);background:#fff;box-shadow:0 0 0 3px #d1fae5}
label{font-size:13px;font-weight:700;color:#374151}
button{padding:14px 18px;border:none;border-radius:12px;background:var(--green);color:#fff;cursor:pointer;font-size:15px;font-weight:700;width:100%;transition:.2s}
button:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(5,150,105,.3)}
.btn-blue{background:#2563eb} .btn-orange{background:#f97316} .btn-gold{background:#f59e0b;color:#111} .btn-red{background:#ef4444} .btn-small{padding:8px 12px;font-size:12px;width:auto;margin:0}
.badge{background:#fef08a;padding:5px 11px;border-radius:20px;font-size:12px;font-weight:700}
.alert-lock{background:#fee2e2;border:1px solid #fca5a5;padding:14px;border-radius:12px;margin:10px 0}
.alert-ok{background:#dcfce7;padding:12px;border-radius:12px;margin:10px 0}
#msgBox{padding:13px;border-radius:12px;margin-bottom:12px;font-weight:600;font-size:14px;display:none}
footer{text-align:center;padding:18px;color:#6b7280;font-size:13px}
@media(max-width:820px){
.hamburger{display:block}
.sidebar{position:fixed;left:-270px;top:0;height:100vh;width:270px;box-shadow:10px 0 30px rgba(0,0,0,.2);padding-top:70px}
.sidebar.open{left:0}
.sidebar .close-btn{display:block;position:absolute;top:12px;right:12px;background:#ef4444;color:#fff;border:none;width:36px;height:36px;border-radius:50%;font-size:18px;cursor:pointer}
.overlay.show{display:block;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:80}
.layout{flex-direction:column}.main{padding:14px}.hero{padding:20px}.hero h1{font-size:22px}.grid{grid-template-columns:1fr}.user-box span{display:none}.logo{font-size:17px}
}
