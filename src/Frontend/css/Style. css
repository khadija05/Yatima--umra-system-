/* ================= YATIMA UMRA - FULL STYLE ================= */
*{
  margin:0; padding:0; box-sizing:border-box;
  font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}
:root{
  --green:#0B6B3A;
  --green-dark:#084E2A;
  --gold:#C9A227;
  --gold-light:#F5E6A8;
  --white:#ffffff;
  --light:#F6F9F7;
  --dark:#1A1A1A;
  --gray:#6B7280;
  --border:#E5E7EB;
  --shadow:0 10px 30px rgba(0,0,0,0.08);
  --radius:16px;
}
body{
  background:var(--light);
  color:var(--dark);
  line-height:1.6;
}
a{ text-decoration:none; color:inherit; }
img{ max-width:100%; display:block; }
button{ cursor:pointer; border:none; font-family:inherit; }

/* ===== NAVBAR ===== */
.navbar{
  background:var(--white);
  padding:14px 5%;
  display:flex; align-items:center; justify-content:space-between;
  box-shadow:0 2px 15px rgba(0,0,0,0.06);
  position:sticky; top:0; z-index:100;
}
.logo{
  display:flex; align-items:center; gap:10px;
  font-size:22px; font-weight:800; color:var(--green);
}
.logo span{ color:var(--gold); }
.nav-links{ display:flex; gap:28px; list-style:none; }
.nav-links a{ font-weight:600; font-size:15px; color:#333; }
.nav-links a:hover, .nav-links a.active{ color:var(--green); }

/* ===== BUTTONS ===== */
.btn{
  display:inline-block; padding:12px 24px;
  border-radius:50px; font-weight:700; font-size:15px;
  transition:0.3s; text-align:center;
}
.btn-green{ background:var(--green); color:#fff; }
.btn-green:hover{ background:var(--green-dark); transform:translateY(-2px); }
.btn-gold{ background:var(--gold); color:#fff; }
.btn-gold:hover{ background:#A8841A; transform:translateY(-2px); }
.btn-white{ background:#fff; color:var(--green); border:1px solid var(--border); }
.btn-outline{ background:transparent; color:var(--green); border:2px solid var(--green); }

/* ===== HERO ===== */
.hero{
  background:linear-gradient(135deg, #0B6B3A 0%, #084E2A 60%, #0B6B3A 100%);
  color:#fff; padding:70px 5% 70px;
  display:flex; align-items:center; justify-content:space-between; gap:40px;
  border-radius:0 0 30px 30px;
}
.hero h1{ font-size:48px; line-height:1.1; margin-bottom:16px; }
.hero h1 span{ color:var(--gold-light); }
.hero p{ font-size:17px; opacity:0.9; max-width:550px; margin-bottom:28px; }
.hero-buttons{ display:flex; gap:14px; flex-wrap:wrap; }
.hero-card{
  background:#fff; color:#333; padding:24px; border-radius:var(--radius);
  width:340px; box-shadow:var(--shadow); text-align:center;
}
.hero-card h3{ color:var(--green); margin-bottom:8px; }
.hero-card .price{ font-size:36px; font-weight:800; color:var(--dark); }
.hero-card .price small{ font-size:14px; color:var(--gray); }

/* ===== SECTION ===== */
.section{ padding:50px 5%; max-width:1200px; margin:0 auto; }
.section-title{ text-align:center; margin-bottom:35px; }
.section-title h2{ font-size:32px; color:var(--green); }
.section-title p{ color:var(--gray); margin-top:8px; }

/* ===== STATS ===== */
.stats{
  display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-top:-30px; position:relative; z-index:2;
}
.stat-card{
  background:#fff; padding:22px; border-radius:var(--radius);
  box-shadow:var(--shadow); text-align:center;
}
.stat-card b{ font-size:28px; color:var(--green); display:block; }
.stat-card span{ color:var(--gray); font-size:14px; }

/* ===== CARDS - MAYATIMA / PACKAGE ===== */
.grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
.card{
  background:#fff; border-radius:var(--radius); overflow:hidden;
  box-shadow:var(--shadow); transition:0.3s;
}
.card:hover{ transform:translateY(-6px); box-shadow:0 20px 40px rgba(0,0,0,0.12); }
.card-img{
  height:210px; background:linear-gradient(135deg,#D1FAE5,#FEF3C7);
  display:flex; align-items:center; justify-content:center;
  font-size:70px;
}
.card-body{ padding:20px; }
.card-body h3{ font-size:19px; margin-bottom:6px; }
.card-body p{ color:var(--gray); font-size:14px; margin-bottom:14px; }
.badge{
  display:inline-block; padding:5px 12px; border-radius:20px;
  font-size:12px; font-weight:700; margin-bottom:10px;
}
.badge-green{ background:#D1FAE5; color:#065F46; }
.badge-gold{ background:#FEF3C7; color:#92400E; }
.price-row{ display:flex; justify-content:space-between; align-items:center; margin-top:14px; }
.price-row b{ font-size:20px; color:var(--green); }

/* ===== FORMS - LOGIN / BOOKING / DONATION ===== */
.form-box{
  max-width:480px; margin:0 auto; background:#fff;
  padding:32px; border-radius:var(--radius); box-shadow:var(--shadow);
}
.form-box h2{ text-align:center; color:var(--green); margin-bottom:6px; }
.form-box > p{ text-align:center; color:var(--gray); font-size:14px; margin-bottom:22px; }
.form-group{ margin-bottom:16px; }
.form-group label{ display:block; font-weight:600; font-size:14px; margin-bottom:6px; }
.form-group input, .form-group select, .form-group textarea{
  width:100%; padding:13px 14px; border:1px solid var(--border);
  border-radius:12px; font-size:15px; outline:none; background:#F9FAFB;
}
.form-group input:focus, .form-group select:focus, .form-group textarea:focus{
  border-color:var(--green); background:#fff; box-shadow:0 0 0 3px rgba(11,107,58,0.1);
}
.form-box .btn{ width:100%; padding:14px; margin-top:6px; }
.form-link{ text-align:center; margin-top:16px; font-size:14px; }
.form-link a{ color:var(--green); font-weight:700; }

/* ===== TABLE - DASHBOARD ===== */
.table-box{ background:#fff; border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow); }
table{ width:100%; border-collapse:collapse; }
table th{ background:var(--green); color:#fff; padding:14px; text-align:left; font-size:14px; }
table td{ padding:14px; border-bottom:1px solid var(--border); font-size:14px; }
table tr:hover td{ background:#F9FAFB; }
.status{ padding:5px 12px; border-radius:20px; font-size:12px; font-weight:700; }
.status-pending{ background:#FEF3C7; color:#92400E; }
.status-approved{ background:#D1FAE5; color:#065F46; }
.status-rejected{ background:#FEE2E2; color:#991B1B; }

/* ===== DASHBOARD LAYOUT ===== */
.dashboard{ display:flex; gap:0; min-height:80vh; }
.sidebar{
  width:250px; background:var(--green-dark); color:#fff; padding:24px 0; flex-shrink:0;
}
.sidebar a{
  display:block; padding:12px 24px; color:#D1FAE5; font-weight:600;
}
.sidebar a:hover, .sidebar a.active{ background:rgba(255,255,255,0.12); color:#fff; border-left:4px solid var(--gold); }
.main-content{ flex:1; padding:28px; }

/* ===== FOOTER ===== */
footer{
  background:#111827; color:#D1D5DB; padding:40px 5% 20px; margin-top:50px;
}
.footer-grid{ display:grid; grid-template-columns:2fr 1fr 1fr; gap:30px; max-width:1200px; margin:0 auto; }
footer h3{ color:#fff; margin-bottom:12px; }
footer p, footer li{ font-size:14px; }
footer ul{ list-style:none; }
footer li{ margin-bottom:8px; }
.copyright{ text-align:center; margin-top:30px; padding-top:18px; border-top:1px solid #374151; font-size:13px; }

/* ===== RESPONSIVE - SIMU ===== */
@media(max-width:900px){
  .hero{ flex-direction:column; text-align:center; padding:40px 5%; }
  .hero h1{ font-size:34px; }
  .hero-buttons{ justify-content:center; }
  .hero-card{ width:100%; }
  .stats{ grid-template-columns:repeat(2,1fr); }
  .grid{ grid-template-columns:repeat(2,1fr); }
  .nav-links{ display:none; }
  .dashboard{ flex-direction:column; }
  .sidebar{ width:100%; display:flex; overflow-x:auto; padding:0; }
  .sidebar a{ white-space:nowrap; border-left:none !important; }
  .footer-grid{ grid-template-columns:1fr; }
}
@media(max-width:550px){
  .grid{ grid-template-columns:1fr; }
  .stats{ grid-template-columns:1fr; }
  .section{ padding:30px 4%; }
  .navbar{ padding:12px 4%; }
}
