*{box-sizing:border-box} body{font-family:Inter,system-ui,sans-serif;margin:0;background:#f3f4f6;color:#111}
.topbar{background:#0b6b3a;color:#fff;padding:14px 18px;display:flex;justify-content:space-between;align-items:center}
.logo{font-weight:800;font-size:18px} .user-box{font-size:13px;display:flex;gap:10px;align-items:center}
.layout{display:flex;min-height:calc(100vh - 58px)}
.sidebar{width:230px;background:#fff;padding:15px;border-right:1px solid #e5e7eb;display:flex;flex-direction:column;gap:6px}
.sidebar a{padding:11px 12px;border-radius:10px;text-decoration:none;color:#111;font-size:14px}
.sidebar a.active,.sidebar a:hover{background:#0b6b3a;color:#fff}
.main{flex:1;padding:20px;max-width:1000px;margin:0 auto;width:100%}
.card{background:#fff;padding:18px;border-radius:14px;box-shadow:0 2px 10px rgba(0,0,0,.05);margin-bottom:14px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.stat{font-size:28px;font-weight:800} .muted{color:#6b7280;font-size:13px}
input,select,textarea{width:100%;padding:11px;margin:6px 0 10px;border:1px solid #ddd;border-radius:10px;font-size:14px}
label{font-size:13px;font-weight:700} button{padding:11px 16px;border:none;border-radius:10px;background:#0b6b3a;color:#fff;cursor:pointer;font-size:14px}
.btn-blue{background:#2563eb} .btn-orange{background:#f97316} .btn-red{background:#ef4444} .btn-small{padding:7px 10px;font-size:12px}
.badge{background:#fef08a;padding:4px 10px;border-radius:20px;font-size:12px;font-weight:700}
.alert-lock{background:#fee2e2;border:1px solid #f00;padding:12px;border-radius:10px;margin:10px 0}
.alert-ok{background:#dcfce7;padding:10px;border-radius:10px;margin:10px 0}
.plan-card{border:2px solid #0b6b3a} footer{text-align:center;padding:15px;color:#666;font-size:13px}
@media(max-width:768px){ .layout{flex-direction:column} .sidebar{width:100%;flex-direction:row;overflow:auto} .topbar{flex-direction:column;gap:8px} }
